# Persistent data root. On Render, set this to the mounted disk directory.
NBA_DATA_DIR=/var/data/nba
NBA_REPORTS_DIR=/var/data/nba/reports

# Comma-separated chronological feature history; append the active season too.
NBA_SEASONS=2021-22,2022-23,2023-24,2024-25,2025-26,2026-27
NBA_ACTIVE_SEASON=2026-27

# Generate a long random value and configure the same value in Render's
# environment settings and the scheduled trigger. Never commit a real secret.
SYNC_CRON_SECRET=replace-with-a-long-random-secret
